# Copiar a .env y completar con los datos reales del proyecto de Supabase.
#   SUPABASE_URL -> Settings > API > Project URL
#   DATABASE_URL -> Settings > Database > Connection string (URI, modo "Session")
# Ya NO hace falta un JWT Secret: el backend valida los tokens contra el
# endpoint público (JWKS) del proyecto, usando solo la URL de arriba.
SUPABASE_URL=https://eqhlxeainbvzfkifszap.supabase.co
DATABASE_URL=postgresql://postgres:[password]@db.eqhlxeainbvzfkifszap.supabase.co:5432/postgres

# Solo para crear clientes desde el panel admin (POST /admin/clientes), que
# necesita crear el usuario en Supabase Auth antes de la ficha en `clientes`.
#   SUPABASE_SERVICE_ROLE_KEY -> Settings > API > Project API keys > service_role
# OJO: esta clave se salta la Row Level Security. Nunca va en el frontend,
# solo en este .env del backend.
SUPABASE_SERVICE_ROLE_KEY=
